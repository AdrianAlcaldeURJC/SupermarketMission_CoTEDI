  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ExplicationCanvas_es-ES
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 156367ae9e65d074e88f82b1455d7621, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 37314015232
    m_Localized: "Paso dos: \xA1A explorar! Identifiquemos en el mapa d\xF3nde est\xE1
      cada secci\xF3n. Arrastra el nombre de cada una a su dibujo correspondiente."
    m_Metadata:
      m_Items: []
  - m_Id: 2964455862272
    m_Localized: "\xA1Hora de actuar! Elige qu\xE9 secci\xF3n visitar en el mapa.
      Recuerda mirar tu lista de objetivos (bot\xF3n en la esquina) para ver qu\xE9
      falta."
    m_Metadata:
      m_Items: []
  - m_Id: 273532350541824
    m_Localized: "\xA1Una fruta, un color! \xA1Coge las frutas que necesites!"
    m_Metadata:
      m_Items: []
  - m_Id: 273545109614592
    m_Localized: "\xA1Mira las sombras de los objetos! \xA1Selecciona las que necesites!"
    m_Metadata:
      m_Items: []
  - m_Id: 301768975495168
    m_Localized: "\xA1Bot\xEDn listo! Gu\xE1rdalo en nuestra base: El Carro. \xA1Ojo!
      Si pones cosas pesadas sobre fr\xE1giles... \xA1CRASH! El color de fondo te
      dice si est\xE1 bien colocado. Mira esta gu\xEDa:"
    m_Metadata:
      m_Items: []
  - m_Id: 301843139178496
    m_Localized: "\xA1\xDAltimo desaf\xEDo! \xA1Desl\xEDzate!"
    m_Metadata:
      m_Items: []
  - m_Id: 20235511286640640
    m_Localized: "\xA1Mueve los objetos a su secci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 25001162605768704
    m_Localized: "\xA1Tienes que mover los objetos al carrito!"
    m_Metadata:
      m_Items: []
  - m_Id: 25001236282912768
    m_Localized: "\xA1Pero ten cuidado! \xA1Los objetos se rompen si aguantan demasiado
      peso!"
    m_Metadata:
      m_Items: []
  - m_Id: 25001274392358912
    m_Localized: 'Los tipos de peso, de menor a mayor, son:'
    m_Metadata:
      m_Items: []
  - m_Id: 25001321297260544
    m_Localized: 'La dureza de los objetos, de menor a mayor, es:'
    m_Metadata:
      m_Items: []
  - m_Id: 25001408157102080
    m_Localized: 'El estado de los objetos, de perfecto a roto, es:'
    m_Metadata:
      m_Items: []
  - m_Id: 25001582480764928
    m_Localized: "\xA1Ten en cuenta todos los factores de cada objeto!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
